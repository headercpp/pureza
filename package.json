{
  "name": "pureza",
  "version": "0.1.0",
  "description": "Pureza",
  "main": "electron/main.cjs",
  "author": {
    "name": "EduX"
  },
  "copyright": "Copyright © 2026 EduX",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.pureza.app",
    "productName": "Pureza",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "copyright": "Copyright © 2026 EduX",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Pureza-${version}-setup.${ext}",
      "publisherName": "EduX",
      "legalTrademarks": "Pureza",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pureza",
      "uninstallDisplayName": "Pureza",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.21.5": true
  }
}
